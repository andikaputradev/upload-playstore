# ==============================================================================
# Environment Variables - uploadplaystore.my.id (andikaputradev)
# Salin berkas ini ke .env.local untuk development lokal:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. URL & DOMAIN (Opsional untuk dev lokal, otomatis fallback)
# ------------------------------------------------------------------------------
# URL dasar aplikasi. Default dev: http://localhost:3000
# Default production: https://uploadplaystore.my.id
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. VERIFIKASI MESIN PENCARI (SEO Webmaster - Opsional tapi sangat disarankan)
# ------------------------------------------------------------------------------
# Kode verifikasi Google Search Console (dari tag meta HTML)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Kode verifikasi Bing Webmaster Tools (msvalidate.01)
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ------------------------------------------------------------------------------
# 3. AUTENTIKASI ADMIN PANEL (Wajib untuk fitur /admin)
# ------------------------------------------------------------------------------
# Hash bcrypt dari password login admin. Dibuat sebelum deploy (jangan commit hash asli).
# Contoh pembuatan hash via node:
#   node -e "console.log(require('bcryptjs').hashSync('PASSWORD_ANDA', 10))"
# Catatan: Karakter $ pada bcrypt hash wajib di-escape dengan \$ di .env Next.js agar tidak dianggap variabel.
ADMIN_PASSWORD_HASH=

# Buat string acak minimal 32 karakter, misalnya via terminal:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------------------------
# 4. RATE LIMITING ADMIN LOGIN - UPSTASH REDIS (Wajib untuk proteksi brute force login)
# ------------------------------------------------------------------------------
# Dapatkan kredensial gratis di https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# ------------------------------------------------------------------------------
# 5. INTEGRASI GITHUB CMS (Wajib untuk tulis/edit artikel blog via web admin)
# ------------------------------------------------------------------------------
# Fine-grained Personal Access Token (PAT) dari GitHub dengan hak akses:
# - Repository: repositori ini saja
# - Permissions: Contents -> Read and write
GITHUB_CONTENT_TOKEN=

# Nama repositori GitHub dalam format: owner/repo
# Contoh: andikaputradev/upload-playstore
GITHUB_REPO=andikaputradev/upload-playstore

# Branch tujuan penyimpanan artikel MDX (default: main)
GITHUB_BRANCH=main
